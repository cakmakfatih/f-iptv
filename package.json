{
  "name": "f-iptv",
  "version": "1.0.0",
  "private": true,
  "description": "F-IPTV: an Xtream-compatible live TV, movies and series app for TV browsers, built on zapkit-tv",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cakmakfatih/f-iptv#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cakmakfatih/f-iptv.git"
  },
  "bugs": {
    "url": "https://github.com/cakmakfatih/f-iptv/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "hls.js": "^1.5.17",
    "lucide": "1.66.0",
    "zapkit-tv": "^0.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
